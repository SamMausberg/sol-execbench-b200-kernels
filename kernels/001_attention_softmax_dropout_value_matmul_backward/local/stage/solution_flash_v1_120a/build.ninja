ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=benchmark_kernel -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1018\" -I/home/sam/sol-execbench-b200-kernels/kernels/001_attention_softmax_dropout_value_matmul_backward/local/stage/solution_flash_v1_120a -I/home/sam/cutlass-v441/include -I/home/sam/cutlass-v441/tools/util/include -isystem /home/sam/.local/lib/python3.12/site-packages/torch/include -isystem /home/sam/.local/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /usr/include/python3.12 -fPIC -std=c++17
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=benchmark_kernel -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1018\" -I/home/sam/sol-execbench-b200-kernels/kernels/001_attention_softmax_dropout_value_matmul_backward/local/stage/solution_flash_v1_120a -I/home/sam/cutlass-v441/include -I/home/sam/cutlass-v441/tools/util/include -isystem /home/sam/.local/lib/python3.12/site-packages/torch/include -isystem /home/sam/.local/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /usr/include/python3.12 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_120,code=compute_120 -gencode=arch=compute_120,code=sm_120 --compiler-options '-fPIC' -O3 --use_fast_math -std=c++17 --expt-relaxed-constexpr -DNDEBUG -gencode=arch=compute_120a,code=sm_120a
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -lcuda -L/usr/lib/wsl/lib -L/home/sam/.local/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build k2_sm100.cuda.o: cuda_compile /home/sam/sol-execbench-b200-kernels/kernels/001_attention_softmax_dropout_value_matmul_backward/local/stage/solution_flash_v1_120a/k2_sm100.cu
build k1_sm100.cuda.o: cuda_compile /home/sam/sol-execbench-b200-kernels/kernels/001_attention_softmax_dropout_value_matmul_backward/local/stage/solution_flash_v1_120a/k1_sm100.cu
build kernel.cuda.o: cuda_compile /home/sam/sol-execbench-b200-kernels/kernels/001_attention_softmax_dropout_value_matmul_backward/local/stage/solution_flash_v1_120a/kernel.cu





build benchmark_kernel.so: link k2_sm100.cuda.o k1_sm100.cuda.o kernel.cuda.o

default benchmark_kernel.so
