{
  "author": "SamMausberg",
  "definition": "036_flux_output_norm_projection_chain",
  "description": "CUDA FP32 SiLU and centered normalization with explicit BF16x9-emulated FP32 cuBLASLt projections and bias epilogues.",
  "name": "flux_native_cuda_emulated_fp32_split_build_v7",
  "sources": [
    {
      "path": "binding.cpp"
    },
    {
      "path": "kernels.cu"
    },
    {
      "path": "kernels.h"
    }
  ],
  "spec": {
    "binding": "torch",
    "compile_options": {
      "cflags": [
        "-O3",
        "-std=c++17",
        "-I/venv/lib/python3.12/site-packages/nvidia/cu13/include"
      ],
      "ld_flags": [
        "-L/venv/lib/python3.12/site-packages/nvidia/cu13/lib",
        "-L/usr/local/cuda/lib64",
        "-l:libcublasLt.so.13",
        "-l:libcudart.so.13"
      ],
      "cuda_cflags": [
        "-O3",
        "--fmad=false",
        "-std=c++17",
        "-I/venv/lib/python3.12/site-packages/nvidia/cu13/include"
      ]
    },
    "dependencies": [
      "torch",
      "cublas"
    ],
    "destination_passing_style": true,
    "entry_point": "binding.cpp::run",
    "languages": [
      "cuda_cpp",
      "cublas"
    ],
    "target_hardware": [
      "B200"
    ]
  }
}
